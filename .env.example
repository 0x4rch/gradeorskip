# Copy to .env. Everything is optional: with nothing set you still get measured
# centering, a wider grade range and the ROI math on prices you type in.

# Condition read and card identification. One of these; Anthropic wins if both are set.
# Each check costs about $0.03 of your own API credit.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Auto-filled graded prices (paid PriceCharting subscription).
PRICECHARTING_API_KEY=

# Higher rate limits on pokemontcg.io (free key).
POKEMONTCG_API_KEY=

# Protects a Cloudflare tunnel opened with ./share.sh. Use a long random value.
GRADEORSKIP_ACCESS_KEY=

# If you change the code and run it for other people, the AGPL asks you to offer
# your source. Point this at your copy.
# GRADEORSKIP_SOURCE_URL=https://github.com/you/gradeorskip

# Read PriceCharting's public card pages for prices. Off by default. Read
# "Prices" in the README before turning this on.
# GRADEORSKIP_SCRAPE_PRICECHARTING=1
